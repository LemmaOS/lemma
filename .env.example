# DataBase
LEMMA_DB=lemma-db
LEMMA_DB_USER=lemma
LEMMA_DB_PASSWORD=change-me   # 必填：compose 空密码会拒绝启动
DATABASE_URL=postgresql://lemma:change-me@127.0.0.1:5432/lemma-db   # 密码须与 LEMMA_DB_PASSWORD 一致

# JWT
LEMMA_JWT_SECRET=change-me
LEMMA_SECRET_KEY=change-me

# S3（optional）
LEMMA_S3_ENDPOINT=http://127.0.0.1:9000
LEMMA_S3_REGION=change-me
LEMMA_S3_BUCKET=lemma
LEMMA_S3_ACCESS_KEY_ID=change-me
LEMMA_S3_SECRET_ACCESS_KEY=change-me
