# DataBase
LEMMA_DB=lemma-db
LEMMA_DB_USER=lemma
LEMMA_DB_PASSWORD=change-me   # 必填：compose 空密码会拒绝启动
DATABASE_URL=postgresql://lemma:change-me@127.0.0.1:5432/lemma-db   # 密码须与 LEMMA_DB_PASSWORD 一致

# JWT
LEMMA_JWT_SECRET=change-me
LEMMA_SECRET_KEY=change-me

