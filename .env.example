# 数据库（docker-compose 起 Postgres 用）
LEMMA_DB=lemma-db
LEMMA_DB_USER=lemma
# 必填：compose 空密码会拒绝启动
LEMMA_DB_PASSWORD=change-me

# 服务端连接串（密码与上面 LEMMA_DB_PASSWORD 一致；用 127.0.0.1 不用 localhost，本机 IPv6 疑似被防火墙黑洞）
DATABASE_URL=postgresql://lemma:change-me@127.0.0.1:5432/lemma-db

# 认证与加密
LEMMA_JWT_SECRET=change-me
# 供应商 API Key 的封箱密钥（lemma-providers derive_key/seal）
LEMMA_SECRET_KEY=change-me

# 归档对象存储（可选：五项缺一即整体不启用，归档降级为消息留在 PG；桶需事先建好）
#LEMMA_S3_ENDPOINT=http://127.0.0.1:9000
#LEMMA_S3_REGION=us-east-1
#LEMMA_S3_BUCKET=lemma
#LEMMA_S3_ACCESS_KEY_ID=
#LEMMA_S3_SECRET_ACCESS_KEY=
